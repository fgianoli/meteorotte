# Copia in .env e compila
WEB_PORT=8080
PUBLIC_URL=https://meteorotte.studiogis.eu

# Frequenza di aggiornamento (minuti)
INTERVAL_MIN=60
# Griglia meteo lungo i corridoi: ogni quante ore ricalcolarla e fino a che distanza (km) dai corridoi
GRID_HOURS=3
GRID_KM=30

# Ciclo rapido per idrometri e allerte ufficiali (minuti, minimo 2). Il bot invia entro un minuto dal cambio.
FAST_MIN=5

# Open-Meteo: API pubblica (uso non commerciale) oppure istanza propria / chiave commerciale
OPENMETEO_URL=https://api.open-meteo.com
FLOOD_URL=https://flood-api.open-meteo.com
OPENMETEO_APIKEY=

# Météo-France (facoltativo): chiave gratuita da portail-api.meteofrance.fr con le API
# DonneesPubliquesObservation e DonneesPubliquesVigilance. Scade: il worker avvisa negli ultimi 30 giorni.
METEOFRANCE_APIKEY=

# Feed CAP
CAP_SENDER=meteorotte.studiogis.eu
CAP_SENDER_NAME=MeteoRotte (prototipo)
CAP_STATUS=Actual
CAP_RADIUS_KM=5

# Notifiche push del browser: contatto richiesto dai servizi push (mailto: o URL)
PUSH_CONTACT=mailto:tuo-indirizzo@example.org

# Bot Telegram (profilo "bot"): token da @BotFather
TELEGRAM_TOKEN=
# Codice da dare solo agli operatori: /start <codice>
BOT_ACCESS_CODE=
BOT_REPEAT_HOURS=12
